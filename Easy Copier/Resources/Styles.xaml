<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Easy_Copier.Converters">

    <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:SeverityToInfoBarSeverityConverter x:Key="SeverityConverter"/>
    <converters:PathToImageSourceConverter x:Key="PathToImageSourceConverter"/>

    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="AppWarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="AppErrorBrush" Color="#E81123"/>

    <x:Double x:Key="GameCardWidth">200</x:Double>
    <x:Double x:Key="GameCardHeight">280</x:Double>
    <CornerRadius x:Key="DefaultCornerRadius">8</CornerRadius>

    <Style x:Key="GameCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="ActionPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
