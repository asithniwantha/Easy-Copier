<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Easy_Copier.Views.GameDetailsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Easy_Copier.ViewModels"
    xmlns:models="using:Easy_Copier.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Folder Contents View -->
        <ScrollViewer Grid.Column="0" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.FolderStatusMessage, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsFolderStatusVisible, Mode=OneWay}"
                           Foreground="Red" Opacity="0.5" FontStyle="Italic" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.FolderContents, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSystemItem">
                            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="Gold" />

                                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted, Mode=OneWay}"
                                           VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Separator -->
        <Border Grid.Column="1" Background="Gray" Width="1" Margin="8,12,8,12" Opacity="0.5" />

        <!-- Right Side: System Requirements View -->
        <ScrollViewer Grid.Column="2" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
            <RichTextBlock x:Name="SysReqTextBlock" TextWrapping="Wrap" FontFamily="Consolas" />
        </ScrollViewer>
    </Grid>
</UserControl>
