<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy_Copier.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Easy Copier - About">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Image Source="/Assets/easy copier ico.ico" Width="96" Height="96" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                <TextBlock Text="Easy Copier" Style="{ThemeResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center"/>

                <!-- Version Badge Pill -->
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="v" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Developer:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.DeveloperInfo, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock Text="A modern utility designed to simplify organizing and transferring large game and application libraries to portable drives."
                           TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"/>

                <Button Command="{x:Bind ViewModel.CopyVersionInfoCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copy Version Details"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.OpenGitHubRepoCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                        <TextBlock Text="View Source on GitHub"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.OpenGitHubIssuesCommand}"
                        HorizontalAlignment="Stretch" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                        <TextBlock Text="Report an Issue"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Button Grid.Row="1" Content="Close" Command="{x:Bind ViewModel.CloseWindowCommand}"
                HorizontalAlignment="Center" Margin="0,16,0,0"
                Style="{StaticResource AccentButtonStyle}" Width="120"/>
    </Grid>
</Window>
