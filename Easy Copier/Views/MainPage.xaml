<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easy_Copier.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:models="using:Easy_Copier.Models"
    xmlns:converters="using:Easy_Copier.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.IsGlobalNotificationVisible, Mode=TwoWay}"
                 Title="{x:Bind ViewModel.GlobalNotificationTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.GlobalNotificationMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.GlobalNotificationSeverity, Mode=OneWay, Converter={StaticResource SeverityConverter}}"
                 IsClosable="True"
                 Margin="0,0,0,0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Padding="16,16,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <InfoBar Grid.Row="0" IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}" Severity="Success" Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button Content="Download" Command="{x:Bind ViewModel.DownloadUpdateCommand}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsUpdateReadyToInstall, Mode=OneWay}" Severity="Success" Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button Content="Restart &amp; Apply" Command="{x:Bind ViewModel.RestartAndApplyUpdateCommand}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock Grid.Row="2" Text="Library" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,0"/>

                <CommandBar Grid.Row="3" DefaultLabelPosition="Right"
                            Background="Transparent" HorizontalAlignment="Left"
                            Margin="0,0,0,8">
                    <AppBarButton Icon="Add" Label="Add Folder" Command="{x:Bind ViewModel.AddSourceFolderCommand}"/>
                    <AppBarButton Icon="Refresh" Label="Scan Library" Command="{x:Bind ViewModel.ScanLibraryCommand}"/>
                    <AppBarButton Icon="ClearSelection" Label="Deselect All" Command="{x:Bind ViewModel.ClearSelectionCommand}"/>
                    <AppBarSeparator/>
                    <AppBarButton Icon="Clock" Label="History" Command="{x:Bind ViewModel.OpenHistoryCommand}"/>
                    <AppBarButton Icon="Setting" Label="Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}"/>
                    <AppBarButton Icon="Help" Label="About" Command="{x:Bind ViewModel.OpenAboutCommand}"/>
                </CommandBar>



                <Pivot x:Name="LibraryPivot" Grid.Row="5" SelectedIndex="{x:Bind ViewModel.CurrentTabIndex, Mode=TwoWay}" SelectionChanged="TabOrPivot_SelectionChanged">
                    <PivotItem Header="Games">
                        <local:GamesTabView x:Name="GamesTab" ViewModel="{x:Bind ViewModel.GamesTabViewModel, Mode=OneWay}" SelectionChanged="TabOrPivot_SelectionChanged"/>
                    </PivotItem>

                    <PivotItem Header="Apps">
                        <local:AppsTabView x:Name="AppsTab" ViewModel="{x:Bind ViewModel.AppsTabViewModel, Mode=OneWay}" SelectionChanged="TabOrPivot_SelectionChanged"/>
                    </PivotItem>

                    <PivotItem Header="Films &amp; TV series">
                        <local:TvAndFilmsTabView x:Name="TvAndFilmsTab" ViewModel="{x:Bind ViewModel.TvAndFilmsTabViewModel, Mode=OneWay}" SelectionChanged="TabOrPivot_SelectionChanged"/>
                    </PivotItem>

                    <PivotItem Header="OS Images">
                        <local:OsImagesTabView x:Name="OsImagesTab" ViewModel="{x:Bind ViewModel.OsImagesTabViewModel, Mode=OneWay}" SelectionChanged="TabOrPivot_SelectionChanged"/>
                    </PivotItem>
                </Pivot>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource ActionPanelStyle}" Width="430" MinWidth="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Action Center" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                        <TextBlock Text="Target Drive" FontWeight="SemiBold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="No removable drives found">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RemovableDrive">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{x:Bind DriveLetter}"/>
                                                    <Run Text="{x:Bind DriveLabel}"/>
                                                </TextBlock>
                                                <TextBlock Opacity="0.7" FontSize="12">
                                                    <Run Text="{x:Bind Brand}"/>
                                                    <Run Text="•"/>
                                                    <Run Text="{x:Bind FileSystem}"/>
                                                </TextBlock>
                                                <TextBlock Opacity="0.7" FontSize="12"
                                                           Text="{x:Bind FreeBytes, Converter={StaticResource BytesToSizeConverter}}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                                <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}"
                                                           FontWeight="Bold" FontSize="14"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1" Margin="4,0,0,0"
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.HasSelectedDrive, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.OpenDriveInExplorerCommand}"
                                    ToolTipService.ToolTip="Open drive in File Explorer">
                                <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            </Button>
                            <Button Grid.Column="2" Margin="4,0,0,0"
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.HasSelectedDrive, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.FormatDriveCommand}"
                                    ToolTipService.ToolTip="Format drive">
                                <FontIcon Glyph="&#xE75C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <Button Content="Refresh Drives" Command="{x:Bind ViewModel.RefreshDrivesCommand}"
                                HorizontalAlignment="Stretch"/>

                        <Grid Visibility="{x:Bind ViewModel.HasSelectedDrive, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0"
                                         Value="{x:Bind ViewModel.SelectedDrive.UsedPercentage, Mode=OneWay}"
                                         Maximum="100" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="1" FontSize="12" Opacity="0.7"
                                       Text="{x:Bind ViewModel.DriveSpaceSummary, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" FontSize="12" Opacity="0.7"
                                       Text="{x:Bind ViewModel.DriveDetailsSummary, Mode=OneWay}"/>
                        </Grid>
                        <Grid Visibility="{x:Bind ViewModel.HasCustomDestination, Mode=OneWay}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CustomDestinationPath, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTipService.ToolTip="Custom Destination Path"/>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearCustomDestinationCommand}" Background="Transparent" BorderThickness="0" Padding="4" Margin="4,0,0,0" ToolTipService.ToolTip="Clear custom destination">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.ValidationMessages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ValidationResult">
                                    <InfoBar IsOpen="True" Message="{x:Bind Message}" Margin="0,0,0,4"
                                             Severity="{x:Bind Severity, Converter={StaticResource SeverityConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Transfer Queue" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="7,1"
                                        Visibility="{x:Bind ViewModel.HasQueueItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.QueueCount, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearFinishedQueueItemsCommand}"
                                    Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                    ToolTipService.ToolTip="Clear completed and failed items">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    <TextBlock Text="Clear finished" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Opacity="0.7"
                                    Visibility="{x:Bind ViewModel.IsQueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE896;" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Your queue is empty" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select items and choose Add to Copy Queue" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="220"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TransferQueue, Mode=OneWay}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                        <RepositionThemeTransition/>
                                    </TransitionCollection>
                                </ItemsControl.ItemContainerTransitions>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TransferQueueItem">
                                        <Border Style="{StaticResource QueueCardStyle}" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="8,0,0,8"
                                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource QueueStatusToBrushConverter}}"/>

                                                <StackPanel Grid.Column="1" Spacing="6" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind ItemsSummary}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                                            <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="12"
                                                                      Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource QueueStatusToBrushConverter}}"/>
                                                            <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource QueueStatusToBrushConverter}}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{x:Bind TargetDrive.DriveLetter}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock FontSize="11">
                                                                <Run Text="Rs."/>
                                                                <Run Text="{x:Bind TotalPrice}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>

                                                    <Grid Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{x:Bind ProgressPercentage, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" CornerRadius="3" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="11" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind RemainingTimeText, Mode=OneWay}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,8">
                        <!-- Empty State -->
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10"
                                Visibility="{x:Bind ViewModel.HasSelectedGames, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Opacity="0.7">
                                <FontIcon Glyph="&#xE73A;" FontSize="16"/>
                                <TextBlock Text="No items selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Highlighted Card State -->
                        <Grid Visibility="{x:Bind ViewModel.HasSelectedGames, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Background Tint Border (15% opacity accent) -->
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12" CornerRadius="8"/>
                            <!-- Stroke Border (1px accent) -->
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="14"
                                            MinWidth="28" Height="28" Padding="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGamesCount, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Selected" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7F1;" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGamesTotalBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                       FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="Total" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock FontFamily="Consolas" FontWeight="Bold" FontSize="16"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                            <Run Text="Rs."/>
                                            <Run Text="{x:Bind ViewModel.SelectedGamesTotalPrice, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                                        <Grid Grid.Row="4" Margin="0,0,0,8" Visibility="{x:Bind ViewModel.IsOsImagesTabActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Add to Copy Queue" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.CopySelectedGamesCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,4,0"/>

                        <Button Grid.Column="1" Padding="8" VerticalAlignment="Stretch"
                                Command="{x:Bind ViewModel.SelectCustomDestinationCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedDrive, Mode=OneWay}"
                                ToolTipService.ToolTip="Define destination folder">
                            <FontIcon Glyph="&#xE8D5;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <Button Grid.Row="4" Content="Open in Rufus" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenInRufusCommand}"
                            Visibility="{x:Bind ViewModel.IsOsImagesTabActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ProgressBar Grid.Row="0" IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsTransferring, Mode=OneWay}"
                                     Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
                    </Grid>
                </Grid>
            </Border>

            <local:SmartAdderControl Grid.Column="0"
                                      ViewModel="{x:Bind ViewModel.SmartAdderViewModel}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,0,8,0"/>
        </Grid>
    </Grid>
</Page>
