<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easy_Copier.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:models="using:Easy_Copier.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="LibraryItemTemplate" x:DataType="models:GameEntry">
            <Border Style="{StaticResource GameCardStyle}"
                    Width="{StaticResource GameCardWidth}"
                    Height="{StaticResource GameCardHeight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                          CornerRadius="4">
                        <Image Source="{x:Bind CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}" Stretch="UniformToFill"
                               Visibility="{x:Bind HasCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xE7FC;" FontSize="48" Opacity="0.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{x:Bind HasNoCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <InfoBadge Style="{ThemeResource CautionIconInfoBadgeStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="4,4,36,4"
                                   Visibility="{x:Bind HasLargeFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                   ToolTipService.ToolTip="Contains files larger than 4GB (FAT32 incompatible)"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="4"
                                Padding="4"
                                MinWidth="0"
                                Click="OpenItemFolder_Click"
                                Tag="{x:Bind FolderPath}"
                                ToolTipService.ToolTip="Open folder in File Explorer">
                            <FontIcon Glyph="&#xE838;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{x:Bind Name}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,2"/>

                    <TextBlock Grid.Row="2"
                               Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}"
                               Opacity="0.7" FontSize="12"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="16,16,8,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Library" Style="{StaticResource SectionHeaderStyle}"/>

            <CommandBar Grid.Row="1" DefaultLabelPosition="Right"
                        Background="Transparent" HorizontalAlignment="Left"
                        Margin="0,0,0,8">
                <AppBarButton Icon="Add" Label="Add Folder" Click="AddSourceFolder_Click"/>
                <AppBarButton Icon="Refresh" Label="Scan Library" Command="{x:Bind ViewModel.ScanLibraryCommand}"/>
                <AppBarButton Icon="ClearSelection" Label="Deselect All" Click="DeselectAll_Click"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Setting" Label="Settings" Click="OpenSettings_Click"/>
            </CommandBar>

            <AutoSuggestBox Grid.Row="2" x:Name="SearchBox"
                             PlaceholderText="Search games and apps..."
                             QueryIcon="Find"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,8"/>

            <Pivot x:Name="LibraryPivot" Grid.Row="3">
                <PivotItem Header="Games">
                    <Grid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                      Width="48" Height="48"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock Text="{x:Bind EmptyGamesMessage, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="400" Opacity="0.7"
                                   Visibility="{x:Bind IsGamesEmpty, Mode=OneWay}"/>

                        <GridView x:Name="GamesGridView"
                                  ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                                  ItemTemplate="{StaticResource LibraryItemTemplate}"
                                  SelectionMode="Multiple"
                                  SelectionChanged="GamesGridView_SelectionChanged"
                                  IsItemClickEnabled="False"/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Apps">
                    <Grid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                      Width="48" Height="48"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock Text="{x:Bind EmptyAppsMessage, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="400" Opacity="0.7"
                                   Visibility="{x:Bind IsAppsEmpty, Mode=OneWay}"/>

                        <GridView x:Name="AppsGridView"
                                  ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}"
                                  ItemTemplate="{StaticResource LibraryItemTemplate}"
                                  SelectionMode="Multiple"
                                  SelectionChanged="AppsGridView_SelectionChanged"
                                  IsItemClickEnabled="False"/>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource ActionPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Action Center" Style="{StaticResource SectionHeaderStyle}"/>

                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="Target Drive" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="No removable drives found">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RemovableDrive">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{x:Bind DriveLetter}"/>
                                                <Run Text="{x:Bind DriveLabel}"/>
                                            </TextBlock>
                                            <TextBlock Opacity="0.7" FontSize="12">
                                                <Run Text="{x:Bind Brand}"/>
                                                <Run Text="•"/>
                                                <Run Text="{x:Bind FileSystem}"/>
                                            </TextBlock>
                                            <TextBlock Opacity="0.7" FontSize="12"
                                                       Text="{x:Bind FreeBytes, Converter={StaticResource BytesToSizeConverter}}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}"
                                                       FontWeight="Bold" FontSize="14"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Margin="4,0,0,0"
                                Padding="8"
                                VerticalAlignment="Stretch"
                                IsEnabled="{x:Bind HasSelectedDrive, Mode=OneWay}"
                                Click="OpenDriveInExplorer_Click"
                                ToolTipService.ToolTip="Open drive in File Explorer">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <Button Content="Refresh Drives" Command="{x:Bind ViewModel.RefreshDrivesCommand}"
                            HorizontalAlignment="Stretch"/>

                    <Grid Visibility="{x:Bind HasSelectedDrive, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ProgressBar Grid.Row="0"
                                     Value="{x:Bind ViewModel.SelectedDrive.UsedPercentage, Mode=OneWay}"
                                     Maximum="100" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="1" FontSize="12" Opacity="0.7"
                                   Text="{x:Bind DriveSpaceSummary, Mode=OneWay}"/>
                        <TextBlock Grid.Row="2" FontSize="12" Opacity="0.7"
                                   Text="{x:Bind DriveDetailsSummary, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.ValidationMessages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ValidationResult">
                                <InfoBar IsOpen="True" Message="{x:Bind Message}" Margin="0,0,0,4"
                                         Severity="{x:Bind Severity, Converter={StaticResource SeverityConverter}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Transfer Queue" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="Clear Finished"
                                Command="{x:Bind ViewModel.ClearFinishedQueueItemsCommand}"
                                FontSize="12" Padding="8,4"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TransferQueue, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferQueueItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                                      FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top"/>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind ItemsSummary}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="12" Opacity="0.7">
                                                    <Run Text="{x:Bind TargetDrive.DriveLetter}"/>
                                                    <Run Text="•"/>
                                                    <Run Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}"/>
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,8">
                    <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Row="4" Content="Add to Copy Queue" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.CopySelectedGamesCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsTransferring, Mode=OneWay}"
                                 Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
