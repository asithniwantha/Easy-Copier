<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Easy_Copier.Views.GamesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Easy_Copier.Models"
    xmlns:behaviors="using:Easy_Copier.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,8"
                        PlaceholderText="Search games..."
                        QueryIcon="Find"
                        FontSize="24" MinHeight="40"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Stretch">
            <interactivity:Interaction.Behaviors>
                <behaviors:AutoSuggestBoxSearchBehavior SearchableViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            </interactivity:Interaction.Behaviors>
            <AutoSuggestBox.Resources>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonFontSize">24</x:Double>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonMinWidth">40</x:Double>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonMinHeight">40</x:Double>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </AutoSuggestBox.Resources>
        </AutoSuggestBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" Spacing="8">
            <TextBlock Text="Category:" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableCategories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="150"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Enriched Empty State with Iconography and Theme Hierarchy -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsGamesEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE7FC;" FontSize="44" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyGamesMessage, Mode=OneWay}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>

            <GridView x:Name="GamesGridView"
                      ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                      ItemTemplate="{StaticResource LibraryItemTemplate}"
                      SelectionMode="Multiple"
                      SelectionChanged="GamesGridView_SelectionChanged"
                      ItemContainerStyle="{StaticResource LibraryGridViewItemStyle}"
                      IsItemClickEnabled="False">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True"/>
                        <RepositionThemeTransition/>
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
            </GridView>
        </Grid>
    </Grid>
</UserControl>
