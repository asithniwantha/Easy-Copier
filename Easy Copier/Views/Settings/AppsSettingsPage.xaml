<Page
    x:Class="Easy_Copier.Views.Settings.AppsSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Apps Settings" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Spacing="8">
                <TextBlock Text="App Folders" FontWeight="SemiBold"/>
                <Grid MinHeight="80">
                    <ListView x:Name="AppSourceFoldersListView"
                              ItemsSource="{x:Bind ViewModel.AppSourceFolders, Mode=OneWay}"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              MinHeight="80">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="Remove"
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveSourceFolderByPathCommand}"
                                            CommandParameter="{x:Bind}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state when no app folders are configured -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasNoAppSourceFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE71D;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Text="No app folders added yet. Click 'Add App Folder' below to begin."
                                   Opacity="0.6" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Button Content="Add App Folder" Command="{x:Bind ViewModel.AddNewSourceFolderCommand}" CommandParameter="App"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>

                <TextBox Header="App File Extensions"
                         Text="{x:Bind ViewModel.AppFileExtensions, Mode=TwoWay}"
                         PlaceholderText="e.g. .exe,.msi,.rar,.zip"
                         Margin="0,16,0,0"
                         ToolTipService.ToolTip="Comma-separated extensions to identify standalone app files" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

