<Page
    x:Class="Easy_Copier.Views.Settings.OsImagesSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="OS Images Settings" Style="{StaticResource SectionHeaderStyle}" />

            <!-- OS Image Folders Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="OS Image Source Folders" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid MinHeight="80">
                        <ListView x:Name="OsImageSourceFoldersListView"
                                  ItemsSource="{x:Bind ViewModel.OsImageSourceFolders, Mode=OneWay}"
                                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  MinHeight="80">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Remove"
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveSourceFolderByPathCommand}"
                                                CommandParameter="{x:Bind}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state when no OS image folders are configured -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasNoOsImageSourceFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE74E;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"/>
                            <TextBlock Text="No OS image folders added yet. Click 'Add OS Image Folder' below to begin."
                                       Opacity="0.6" FontSize="13" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Add OS Image Folder" Command="{x:Bind ViewModel.AddNewSourceFolderCommand}" CommandParameter="OsImage"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Rufus Tool Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Rufus Bootable USB Tool" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rufus Executable Path" Foreground="{ThemeResource TextControlHeaderForeground}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind ViewModel.RufusExecutablePath, Mode=TwoWay}"
                                     PlaceholderText="%USERPROFILE%\Downloads\Programs\rufus.exe"
                                     ToolTipService.ToolTip="Path to rufus.exe for opening OS images" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Command="{x:Bind ViewModel.BrowseRufusExecutableCommand}"
                                    ToolTipService.ToolTip="Browse for rufus.exe" />
                        </Grid>
                        <TextBlock Text="Select the Rufus executable to launch bootable drive creation directly from the OS Images tab."
                                   FontSize="12" Foreground="{ThemeResource TextControlHeaderForeground}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
