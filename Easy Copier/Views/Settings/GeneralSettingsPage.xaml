<Page
    x:Class="Easy_Copier.Views.Settings.GeneralSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="General Settings" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Startup & Windows Integration Expander -->
            <controls:SettingsExpander Header="Startup &amp; Windows Integration"
                                       Description="Configure how Easy Copier interacts with Windows on launch"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Auto-scan library on startup"
                                           Description="Automatically scan configured library folders when Easy Copier launches">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Start on Windows log-on"
                                           Description="Automatically launch Easy Copier in the background when signing into Windows">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.StartOnLogon, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Minimize to system tray on close"
                                           Description="Keep background transfers running in the system tray when closing the main window">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Updates & Maintenance Expander -->
            <controls:SettingsExpander Header="Updates &amp; Maintenance"
                                       Description="Manage updates and database maintenance tools"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE895;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Automatic background updates"
                                           Description="Automatically download and prepare new updates in the background">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoDownloadUpdates, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Check for updates now"
                                           Description="Manually query for latest releases and patches"
                                           ActionIconToolTip="Check for updates"
                                           IsClickEnabled="True"
                                           Command="{x:Bind ViewModel.CheckForUpdatesNowCommand}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Find duplicate library items"
                                           Description="Detect and report duplicates across all configured source libraries"
                                           ActionIconToolTip="Find duplicates"
                                           IsClickEnabled="True"
                                           Command="{x:Bind ViewModel.FindDuplicatesCommand}">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Notifications Expander -->
            <controls:SettingsExpander Header="Notifications &amp; Feedback"
                                       Description="Manage audio and visual alerts for transfer operations"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Sound notifications"
                                           Description="Play sound effects when file copy tasks complete or fail">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.PlayNotificationSounds, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Desktop toast notifications"
                                           Description="Display native Windows notifications upon batch transfer completion">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowDesktopNotifications, Mode=TwoWay}"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Data Verification & Integrity Expander -->
            <controls:SettingsExpander Header="Data Verification &amp; Integrity"
                                       Description="Configure post-copy file size and cryptographic checksum validation"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A1;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Post-copy verification mode"
                                           Description="Choose how copied files are validated against corruption or incomplete writes">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.VerificationModeIndex, Mode=TwoWay}" MinWidth="220">
                            <ComboBoxItem Content="None (Fastest)"/>
                            <ComboBoxItem Content="Quick (File Size &amp; Count)"/>
                            <ComboBoxItem Content="Fast XxHash64 (SIMD Hashing)"/>
                            <ComboBoxItem Content="Full SHA-256 (Cryptographic)"/>
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
