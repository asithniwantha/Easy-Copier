<Page
    x:Class="Easy_Copier.Views.Settings.LogsSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Logs &amp; Troubleshooting" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Access diagnostic logs for troubleshooting and support." TextWrapping="Wrap" />
            <Button Content="Open Logs Folder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
