<Page
    x:Class="Easy_Copier.Views.Settings.GamesSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Games Settings" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Pricing Tiers SettingsExpander -->
            <controls:SettingsExpander Header="Pricing Tiers (Rs.)"
                                       Description="Configure game copy charges by file size thresholds"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D8;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Tier 1 (Up to 5 GB)"
                                           Description="Base price for smaller games under 5 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 2 (5.1 GB to 10 GB)"
                                           Description="Price for games between 5.1 GB and 10 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 3 (10.1 GB to 15.9 GB)"
                                           Description="Price for mid-sized games between 10.1 GB and 15.9 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 4 (16 GB and above)"
                                           Description="Price for large games 16 GB and above"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Game Folders & Assets SettingsExpander -->
            <controls:SettingsExpander Header="Game Source Folders &amp; Metadata"
                                       Description="Manage directories scanned for games and download cover assets"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F4;"/>
                </controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add Game Folder" Command="{x:Bind ViewModel.AddNewSourceFolderCommand}" CommandParameter="Game"/>
                    <Button Content="Download Covers &amp; Requirements"
                            Command="{x:Bind ViewModel.DownloadGameInfoCommand}"
                            IsEnabled="{x:Bind ViewModel.CanDownloadCovers, Mode=OneWay}"
                            ToolTipService.ToolTip="Downloads cover images and system requirements for all games in configured folders"/>
                    <Button Content="Cancel Download"
                            Command="{x:Bind ViewModel.CancelDownloadGameInfoCommand}"
                            Visibility="{x:Bind ViewModel.IsDownloadingCovers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <CheckBox Content="Overwrite existing covers"
                              IsChecked="{x:Bind ViewModel.OverwriteExistingCovers, Mode=TwoWay}"
                              ToolTipService.ToolTip="Re-download and replace existing cover images even if already present"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard ContentAlignment="Vertical">
                        <Grid MinHeight="80" Margin="0,4,0,4">
                            <ListView x:Name="GameSourceFoldersListView"
                                      ItemsSource="{x:Bind ViewModel.GameSourceFolders, Mode=OneWay}"
                                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      MinHeight="80">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Remove"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveSourceFolderByPathCommand}"
                                                    CommandParameter="{x:Bind}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state when no game folders are configured -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasNoGameSourceFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"/>
                                <TextBlock Text="No game folders added yet. Click 'Add Game Folder' above to begin."
                                           Opacity="0.6" FontSize="13" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
