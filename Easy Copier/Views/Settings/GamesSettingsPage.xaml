<Page
    x:Class="Easy_Copier.Views.Settings.GamesSettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Games Settings" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Pricing Tiers SettingsExpander -->
            <controls:SettingsExpander Header="Pricing Tiers (Rs.)"
                                       Description="Configure game copy charges by file size thresholds"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D8;"/>
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Tier 1 (Up to 5 GB)"
                                           Description="Base price for smaller games under 5 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 2 (5.1 GB to 10 GB)"
                                           Description="Price for games between 5.1 GB and 10 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 3 (10.1 GB to 15.9 GB)"
                                           Description="Price for mid-sized games between 10.1 GB and 15.9 GB"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Tier 4 (16 GB and above)"
                                           Description="Price for large games 16 GB and above"
                                           ContentAlignment="Right">
                        <TextBox Text="{x:Bind ViewModel.PriceTier4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Game Source Folders SettingsExpander -->
            <controls:SettingsExpander Header="Game Source Folders"
                                       Description="Manage directories scanned for game titles"
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F4;"/>
                </controls:SettingsExpander.HeaderIcon>
                <Button Command="{x:Bind ViewModel.AddNewSourceFolderCommand}" CommandParameter="Game">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="Add Folder"/>
                    </StackPanel>
                </Button>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard ContentAlignment="Left"
                                           HorizontalContentAlignment="Stretch"
                                           HorizontalAlignment="Stretch">
                        <Grid MinHeight="80" Margin="0,4,0,4" HorizontalAlignment="Stretch">
                            <ListView x:Name="GameSourceFoldersListView"
                                      ItemsSource="{x:Bind ViewModel.GameSourceFolders, Mode=OneWay}"
                                      SelectionMode="None"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      MinHeight="80">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="4,2" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8F4;" FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind}"/>
                                            <Button Grid.Column="2"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveSourceFolderByPathCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="Remove folder"
                                                    Padding="8,6"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state when no game folders are configured -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasNoGameSourceFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE7FC;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"/>
                                <TextBlock Text="No game folders added yet. Click 'Add Folder' above to begin."
                                           Opacity="0.6" FontSize="13" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Game Cover Art & Metadata SettingsCard -->
            <controls:SettingsCard Header="Cover Art &amp; System Requirements"
                                   Description="Download vertical box art and hardware requirements for all detected games">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEB9F;"/>
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Overwrite existing covers"
                              IsChecked="{x:Bind ViewModel.OverwriteExistingCovers, Mode=TwoWay}"
                              ToolTipService.ToolTip="Re-download and replace existing cover images even if already present"
                              VerticalAlignment="Center"/>
                    <Button Command="{x:Bind ViewModel.DownloadGameInfoCommand}"
                            IsEnabled="{x:Bind ViewModel.CanDownloadCovers, Mode=OneWay}"
                            ToolTipService.ToolTip="Downloads cover images and system requirements for all games in configured folders">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                            <TextBlock Text="Download Covers"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CancelDownloadGameInfoCommand}"
                            Visibility="{x:Bind ViewModel.IsDownloadingCovers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Cancel ongoing download operation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
