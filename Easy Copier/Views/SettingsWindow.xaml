<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy_Copier.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Easy Copier - Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <ToggleSwitch Grid.Row="1" Header="Auto-scan library on startup"
                      IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}"
                      Margin="0,0,0,16"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Game Folders" FontWeight="SemiBold"/>
                <ListView x:Name="GameSourceFoldersListView"
                          ItemsSource="{x:Bind ViewModel.GameSourceFolders, Mode=OneWay}"
                          MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Remove"
                                        Click="RemoveGameFolder_Click" Tag="{x:Bind}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Add Game Folder" Command="{x:Bind ViewModel.AddGameSourceFolderCommand}"
                            HorizontalAlignment="Left"/>
                    <Button Content="Download Covers &amp; Requirements"
                            Command="{x:Bind ViewModel.DownloadGameInfoCommand}"
                            ToolTipService.ToolTip="Downloads cover images and system requirements for all games in configured folders"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="App Folders" FontWeight="SemiBold"/>
                <ListView x:Name="AppSourceFoldersListView"
                          ItemsSource="{x:Bind ViewModel.AppSourceFolders, Mode=OneWay}"
                          MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Remove"
                                        Click="RemoveAppFolder_Click" Tag="{x:Bind}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Add App Folder" Command="{x:Bind ViewModel.AddAppSourceFolderCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Spacing="8">
                <TextBlock Text="Film &amp; TV Folders" FontWeight="SemiBold"/>
                <ListView x:Name="TvAndFilmSourceFoldersListView"
                          ItemsSource="{x:Bind ViewModel.TvAndFilmSourceFolders, Mode=OneWay}"
                          MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Remove"
                                        Click="RemoveTvAndFilmFolder_Click" Tag="{x:Bind}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Add Film/TV Folder" Command="{x:Bind ViewModel.AddTvAndFilmSourceFolderCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>

                <TextBox Header="Video File Extensions"
                         Text="{x:Bind ViewModel.VideoFileExtensions, Mode=TwoWay}"
                         PlaceholderText="e.g. .mp4,.mkv,.avi"
                         Margin="0,16,0,0"
                         ToolTipService.ToolTip="Comma-separated extensions to identify standalone video files" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7"/>
            <Button Content="Open Data Folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}"/>
            <Button Content="Save and Close" Style="{StaticResource AccentButtonStyle}" Click="SaveAndClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
