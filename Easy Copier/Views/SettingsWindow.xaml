<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy_Copier.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Easy Copier - Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <NavigationView x:Name="SettingsNav"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="SettingsNav_SelectionChanged"
                        Loaded="SettingsNav_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="General" Content="General">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Games" Content="Games">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Apps" Content="Apps">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="FilmAndTv" Content="Film &amp; TV">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Logs" Content="Logs &amp; Troubleshooting">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24">
                <Grid>
                    <!-- General Panel -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Visible" Spacing="16">
                        <TextBlock Text="General Settings" FontSize="20" FontWeight="SemiBold" />
                        <ToggleSwitch Header="Auto-scan library on startup"
                                      IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}"/>
                        <ToggleSwitch Header="Start application on Windows log-on"
                                      IsOn="{x:Bind ViewModel.StartOnLogon, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Games Panel -->
                    <StackPanel x:Name="GamesPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Games Settings" FontSize="20" FontWeight="SemiBold" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Game Prices (Rs.)" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Up to 5 GB:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PriceTier1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="5.1 GB to 10 GB:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{x:Bind ViewModel.PriceTier2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="10.1 GB to 15.9 GB:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PriceTier3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="16 GB and above:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{x:Bind ViewModel.PriceTier4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Game Folders" FontWeight="SemiBold"/>
                            <ListView x:Name="GameSourceFoldersListView"
                                      ItemsSource="{x:Bind ViewModel.GameSourceFolders, Mode=OneWay}"
                                      MaxHeight="300"
                                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Remove"
                                                    Click="RemoveGameFolder_Click" Tag="{x:Bind}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Add Game Folder" Command="{x:Bind ViewModel.AddGameSourceFolderCommand}"
                                        HorizontalAlignment="Left"/>
                                <Button Content="Download Covers &amp; Requirements"
                                        Command="{x:Bind ViewModel.DownloadGameInfoCommand}"
                                        ToolTipService.ToolTip="Downloads cover images and system requirements for all games in configured folders"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Apps Panel -->
                    <StackPanel x:Name="AppsPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Apps Settings" FontSize="20" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="App Folders" FontWeight="SemiBold"/>
                            <ListView x:Name="AppSourceFoldersListView"
                                      ItemsSource="{x:Bind ViewModel.AppSourceFolders, Mode=OneWay}"
                                      MaxHeight="300"
                                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Remove"
                                                    Click="RemoveAppFolder_Click" Tag="{x:Bind}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Add App Folder" Command="{x:Bind ViewModel.AddAppSourceFolderCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Film & TV Panel -->
                    <StackPanel x:Name="FilmAndTvPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Film &amp; TV Settings" FontSize="20" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Film &amp; TV Folders" FontWeight="SemiBold"/>
                            <ListView x:Name="TvAndFilmSourceFoldersListView"
                                      ItemsSource="{x:Bind ViewModel.TvAndFilmSourceFolders, Mode=OneWay}"
                                      MaxHeight="300"
                                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Remove"
                                                    Click="RemoveTvAndFilmFolder_Click" Tag="{x:Bind}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Add Film/TV Folder" Command="{x:Bind ViewModel.AddTvAndFilmSourceFolderCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>

                            <TextBox Header="Video File Extensions"
                                     Text="{x:Bind ViewModel.VideoFileExtensions, Mode=TwoWay}"
                                     PlaceholderText="e.g. .mp4,.mkv,.avi"
                                     Margin="0,16,0,0"
                                     ToolTipService.ToolTip="Comma-separated extensions to identify standalone video files" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Logs Panel -->
                    <StackPanel x:Name="LogsPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Logs &amp; Troubleshooting" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Access diagnostic logs for troubleshooting and support." TextWrapping="Wrap" />
                        <Button Content="Open Logs Folder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Bottom Actions -->
        <Border Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7"/>
                <Button Content="Open Data Folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}"/>
                <Button Content="Save and Close" Style="{StaticResource AccentButtonStyle}" Click="SaveAndClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
