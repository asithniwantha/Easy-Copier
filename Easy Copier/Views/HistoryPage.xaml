<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easy_Copier.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:Easy_Copier.ViewModels"
    xmlns:converters="using:Easy_Copier.Converters"
    xmlns:models="using:Easy_Copier.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{Binding IsSuccess}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="Completed" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Failed" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Dashboard -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Grid Area (with drawer) -->
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Transfer History" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Top KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Total Revenue" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="Rs "/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalAmount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Total Volume" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalItems, Mode=OneWay}"/>
                        <Run Text=" items (" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text=")" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Success Rate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedFilterStats.SuccessRate, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top Filter Bar -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{x:Bind ViewModel.IsDashboardVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Dashboard" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ComboBox HorizontalAlignment="Right" Width="150"
                              ItemsSource="{x:Bind ViewModel.DashboardRangeOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedDashboardRange, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Daily volume" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DailyTotals, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PeriodTotal">
                                        <Grid Width="36" Height="130">
                                            <Rectangle Height="{x:Bind BarHeight}" RadiusX="3" RadiusY="3"
                                                       VerticalAlignment="Bottom" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Failure rate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.FailureRateText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Weekly totals" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WeeklyTotals, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PeriodTotal">
                                    <TextBlock FontSize="12">
                                        <Run Text="{x:Bind Label}"/>
                                        <Run Text=": "/>
                                        <Run Text="{x:Bind TotalItems}"/>
                                        <Run Text=" items, "/>
                                        <Run Text="{x:Bind FailedItems}"/>
                                        <Run Text=" failed"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Most copied" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TopCopiedItem">
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind CopyCount}" FontWeight="SemiBold"/>
                                        <Run Text="x "/>
                                        <Run Text="{x:Bind Name}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            PlaceholderText="Search Game/Drive..."
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            Width="250" Margin="0,0,12,0"/>

            <ComboBox Grid.Column="1"
                      Header="Date:"
                      ItemsSource="{x:Bind ViewModel.AvailableDateFilterStrings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDateFilterString, Mode=TwoWay}"
                      Width="150" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

            <ComboBox Grid.Column="2"
                      Header="Status:"
                      ItemsSource="{x:Bind ViewModel.AvailableStatusFilterStrings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatusFilterString, Mode=TwoWay}"
                      Width="120" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

            <Button Grid.Column="2" HorizontalAlignment="Right" Margin="130,0,0,0" VerticalAlignment="Bottom" Content="Clear" ToolTipService.ToolTip="Reset search and filters" Command="{x:Bind ViewModel.ClearFiltersCommand}"/>

            <Button Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ToggleDashboardCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D2;" FontSize="14"/>
                    <TextBlock Text="Dashboard"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Command="{x:Bind ViewModel.ExportToCsvCommand}"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="Export CSV"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Grid & SplitView Drawer -->
        <SplitView Grid.Row="4"
                   IsPaneOpen="{x:Bind ViewModel.IsDrawerOpen, Mode=TwoWay}"
                   DisplayMode="Overlay"
                   PanePlacement="Right"
                   OpenPaneLength="350">
            <SplitView.Content>
				<Grid>
					<ListView ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
							  SelectedItem="{x:Bind ViewModel.SelectedRecord, Mode=TwoWay}"
							  SelectionMode="Single">
						<ListView.ItemContainerStyle>
							<Style TargetType="ListViewItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
								<Setter Property="Margin" Value="0,0,0,6"/>
								<Setter Property="Padding" Value="0"/>
							</Style>
						</ListView.ItemContainerStyle>
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="models:CopyHistoryRecord">
								<Grid Padding="16,12" ColumnSpacing="16"
									  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									  BorderThickness="1" CornerRadius="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="120"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource StatusBadgeTemplate}" VerticalAlignment="Center"/>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="{x:Bind GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
										<TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
											<Run Text="{x:Bind Timestamp}"/>
											<Run Text=" • "/>
											<Run Text="{x:Bind TargetDriveLetter}"/>
											<Run Text="{x:Bind TargetDriveLabel}"/>
										</TextBlock>
									</StackPanel>
									<StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
										<TextBlock Text="{x:Bind BytesTransferred, Converter={StaticResource BytesToSizeConverter}}" HorizontalAlignment="Right" FontFamily="Consolas"/>
										<TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
											<Run Text="Rs "/>
											<Run Text="{x:Bind Amount}"/>
										</TextBlock>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
								Visibility="{x:Bind ViewModel.HasNoRecords, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
						<FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
						<TextBlock Text="No transfers match your filters" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
						<Button Content="Clear filters" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFiltersCommand}"/>
					</StackPanel>
				</Grid>
            </SplitView.Content>

            <SplitView.Pane>
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.CloseDrawerCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="Transfer Details" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="16">
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedRecord, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Item Name" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.GameName, Mode=OneWay}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Source Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.SourcePath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Destination Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.DestinationPath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.SelectedRecord.IsSuccess, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                <TextBlock Text="Error Log" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.ErrorLog, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sub-Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedRecordSubFiles, Mode=OneWay}"
                                          SelectionMode="None"
                                          MaxHeight="300"
                                          Background="{ThemeResource LayerFillColorAltBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" FontSize="12"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>
        </SplitView>
    </Grid>
</Page>
