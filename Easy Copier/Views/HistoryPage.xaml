<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easy_Copier.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:Easy_Copier.ViewModels"
    xmlns:converters="using:Easy_Copier.Converters"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.Resources>
            <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Transfer History" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <ComboBox x:Name="WeekSelector"
                          ItemsSource="{x:Bind ViewModel.AvailableWeeks, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedWeek, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          PlaceholderText="Select Week"
                          Width="250"/>

                <ComboBox x:Name="MonthSelector"
                          ItemsSource="{x:Bind ViewModel.AvailableMonths, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          PlaceholderText="Select Month"
                          Width="200"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ExportToCsvCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="Export to CSV"/>
                </StackPanel>
            </Button>
        </Grid>

        <controls:DataGrid Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  AlternatingRowBackground="{ThemeResource LayerFillColorAltBrush}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Date" Binding="{Binding Timestamp}" Width="200"/>
                <controls:DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="250"/>
                <controls:DataGridTextColumn Header="Drive" Binding="{Binding TargetDriveLetter}" Width="60"/>
                <controls:DataGridTextColumn Header="Label" Binding="{Binding TargetDriveLabel}" Width="150"/>
                <controls:DataGridTextColumn Header="Size" Binding="{Binding BytesTransferred, Converter={StaticResource BytesToSizeConverter}}" Width="100"/>
                <controls:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="80"/>
                <controls:DataGridTextColumn Header="Batch Total" Binding="{Binding BatchAmount}" Width="100"/>
                <controls:DataGridCheckBoxColumn Header="Success" Binding="{Binding IsSuccess}" Width="80"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Margin="0,12,0,0"
                   Style="{ThemeResource CaptionTextBlockStyle}"/>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Selected Filter Stats -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.SelectedFilterName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalItems, Mode=OneWay}" />
                    <Run Text=" items (" />
                    <Run Text="{x:Bind ViewModel.SelectedFilterStats.SuccessfulItems, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <Run Text=" successful)" />
                </TextBlock>
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                    <Run Text="Total Bytes: " />
                    <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                    <Run Text="Total Amount: " />
                    <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalAmount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Today Stats -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Today" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.TodayStats.TotalItems, Mode=OneWay}" />
                    <Run Text=" items (" />
                    <Run Text="{x:Bind ViewModel.TodayStats.SuccessfulItems, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <Run Text=" successful)" />
                </TextBlock>
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                    <Run Text="Total Bytes: " />
                    <Run Text="{x:Bind ViewModel.TodayStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                    <Run Text="Total Amount: " />
                    <Run Text="{x:Bind ViewModel.TodayStats.TotalAmount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Week Stats -->
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="This Week" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.WeekStats.TotalItems, Mode=OneWay}" />
                    <Run Text=" items (" />
                    <Run Text="{x:Bind ViewModel.WeekStats.SuccessfulItems, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <Run Text=" successful)" />
                </TextBlock>
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                    <Run Text="Total Bytes: " />
                    <Run Text="{x:Bind ViewModel.WeekStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                    <Run Text="Total Amount: " />
                    <Run Text="{x:Bind ViewModel.WeekStats.TotalAmount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Month Stats -->
            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="This Month" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.MonthStats.TotalItems, Mode=OneWay}" />
                    <Run Text=" items (" />
                    <Run Text="{x:Bind ViewModel.MonthStats.SuccessfulItems, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <Run Text=" successful)" />
                </TextBlock>
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                    <Run Text="Total Bytes: " />
                    <Run Text="{x:Bind ViewModel.MonthStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                    <Run Text="Total Amount: " />
                    <Run Text="{x:Bind ViewModel.MonthStats.TotalAmount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
