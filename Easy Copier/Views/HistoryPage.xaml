<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easy_Copier.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:Easy_Copier.ViewModels"
    xmlns:converters="using:Easy_Copier.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border Padding="6,2" CornerRadius="4"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <Setter Property="Opacity" Value="0.2"/>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding IsSuccess}"/>
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    <TextBlock Text="{Binding IsSuccess, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Completed|Failed'}"
                               FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Grid Area (with drawer) -->
        </Grid.RowDefinitions>

        <TextBlock Text="Transfer History" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

        <!-- Top KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Revenue" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="Rs "/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalAmount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Volume" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalItems, Mode=OneWay}"/>
                        <Run Text=" items (" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text=")" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Success Rate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedFilterStats.SuccessRate, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top Filter Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            PlaceholderText="Search Game/Drive..."
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            Width="250" Margin="0,0,12,0"/>

            <ComboBox Grid.Column="1"
                      Header="Date:"
                      ItemsSource="{x:Bind ViewModel.AvailableDateFilters, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDateFilterString, Mode=TwoWay}"
                      Width="150" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

            <ComboBox Grid.Column="2"
                      Header="Status:"
                      ItemsSource="{x:Bind ViewModel.AvailableStatusFilters, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatusFilterString, Mode=TwoWay}"
                      Width="120" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

            <Button Grid.Column="4"
                    Command="{x:Bind ViewModel.ExportToCsvCommand}"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="Export CSV"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Grid & SplitView Drawer -->
        <SplitView Grid.Row="3"
                   IsPaneOpen="{x:Bind ViewModel.IsDrawerOpen, Mode=TwoWay}"
                   DisplayMode="Overlay"
                   PanePlacement="Right"
                   OpenPaneLength="350">
            <SplitView.Content>
                <controls:DataGrid ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                                   SelectedItem="{x:Bind ViewModel.SelectedRecord, Mode=TwoWay}"
                                   AutoGenerateColumns="False"
                                   CanUserSortColumns="True"
                                   HeadersVisibility="Column"
                                   GridLinesVisibility="Horizontal"
                                   IsReadOnly="True"
                                   AlternatingRowBackground="{ThemeResource LayerFillColorAltBrush}">
                    <controls:DataGrid.Columns>
                        <!-- Left-aligned textual data -->
                        <controls:DataGridTemplateColumn Header="Status" Width="100" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                        <controls:DataGridTextColumn Header="Date &amp; Time" Binding="{Binding Timestamp}" Width="160"/>
                        <controls:DataGridTextColumn Header="Game / Item" Binding="{Binding GameName}" Width="250"/>
                        <controls:DataGridTextColumn Header="Drive" Binding="{Binding TargetDriveLetter}" Width="60"/>
                        <controls:DataGridTextColumn Header="Label" Binding="{Binding TargetDriveLabel}" Width="120"/>

                        <!-- Right-aligned numerical data -->
                        <controls:DataGridTextColumn Header="Size" Binding="{Binding BytesTransferred, Converter={StaticResource BytesToSizeConverter}}" Width="90">
                            <controls:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
                                </Style>
                            </controls:DataGridTextColumn.ElementStyle>
                        </controls:DataGridTextColumn>
                        <controls:DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="80">
                            <controls:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
                                </Style>
                            </controls:DataGridTextColumn.ElementStyle>
                        </controls:DataGridTextColumn>
                        <controls:DataGridTextColumn Header="Batch Total" Binding="{Binding BatchAmount}" Width="90">
                            <controls:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
                                </Style>
                            </controls:DataGridTextColumn.ElementStyle>
                        </controls:DataGridTextColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </SplitView.Content>

            <SplitView.Pane>
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.CloseDrawerCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="Transfer Details" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="16">
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedRecord, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Item Name" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.GameName, Mode=OneWay}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Source Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.SourcePath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Destination Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.DestinationPath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.SelectedRecord.IsSuccess, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                <TextBlock Text="Error Log" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.ErrorLog, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sub-Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedRecordSubFiles, Mode=OneWay}"
                                          SelectionMode="None"
                                          MaxHeight="300"
                                          Background="{ThemeResource LayerFillColorAltBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" FontSize="12"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>
        </SplitView>
    </Grid>
</Page>