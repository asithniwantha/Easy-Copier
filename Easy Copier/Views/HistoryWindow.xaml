<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy_Copier.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:Easy_Copier.ViewModels"
    mc:Ignorable="d"
    Title="Transfer History">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Transfer History" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="MonthSelector"
                      ItemsSource="{x:Bind ViewModel.AvailableMonths, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      PlaceholderText="Select Month"
                      Width="200"
                      Grid.Column="0"/>

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ExportToCsvCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="Export to CSV"/>
                </StackPanel>
            </Button>
        </Grid>

        <controls:DataGrid Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  AlternatingRowBackground="{ThemeResource LayerFillColorAltBrush}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Date" Binding="{Binding Timestamp}" Width="200"/>
                <controls:DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="250"/>
                <controls:DataGridTextColumn Header="Drive" Binding="{Binding TargetDriveLetter}" Width="60"/>
                <controls:DataGridTextColumn Header="Label" Binding="{Binding TargetDriveLabel}" Width="150"/>
                <controls:DataGridTextColumn Header="Size" Binding="{Binding BytesTransferred}" Width="100"/>
                <controls:DataGridCheckBoxColumn Header="Success" Binding="{Binding IsSuccess}" Width="80"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Margin="0,12,0,0"
                   Style="{ThemeResource CaptionTextBlockStyle}"/>
    </Grid>
</Window>
