<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy_Copier.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy_Copier.Views"
    xmlns:vm="using:Easy_Copier.ViewModels"
    xmlns:models="using:Easy_Copier.Models"
    xmlns:converters="using:Easy_Copier.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Copy History">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Resources/Styles.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: month filter -->
        <Border Grid.Column="0" Style="{StaticResource ActionPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Copy History"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,8,0,16"/>

                <Button Grid.Row="1"
                        Content="All Time"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Command="{x:Bind ViewModel.LoadAllCommand}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ListView x:Name="MonthsList"
                              ItemsSource="{x:Bind ViewModel.AvailableMonths}"
                              SelectionMode="Single"
                              SelectionChanged="MonthsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthOption">
                                <TextBlock Text="{x:Bind Label}" Padding="4,6"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0">
                    <Button Content="Export CSV"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ExportCurrentCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <Button Content="Clear All History"
                            HorizontalAlignment="Stretch"
                            Click="ClearHistory_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel: entries table -->
        <Grid Grid.Column="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <InfoBar Grid.Row="0"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Margin="0,0,0,12"/>

            <ProgressRing Grid.Row="1"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="48"
                          Height="48"
                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Entries}"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                <ListView.Header>
                    <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Destination" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Drive" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Size" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Copied At" FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CopyHistoryEntry">
                        <Grid Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE930;"
                                          FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          Visibility="{x:Bind Success, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <FontIcon Glyph="&#xEA39;"
                                          FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind Success, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{x:Bind ItemName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ItemName}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{x:Bind CategoryLabel}" Opacity="0.7"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind DestinationPath}"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.7"
                                       ToolTipService.ToolTip="{x:Bind DestinationPath}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind TargetDrive}" Opacity="0.7"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind SizeLabel}" Opacity="0.7"/>
                            <TextBlock Grid.Column="5"
                                       Text="{x:Bind CopiedAt}"
                                       Opacity="0.7"
                                       FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
