<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Easy_Copier.Views.TvAndFilmsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Easy_Copier.Models"
    xmlns:converters="using:Easy_Copier.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SortDirectionGlyphConverter x:Key="SortDirectionGlyphConverter"/>
        <converters:SortDirectionToolTipConverter x:Key="SortDirectionToolTipConverter"/>

        <DataTemplate x:Key="LibraryItemTemplate" x:DataType="models:GameEntry">
            <Border Style="{StaticResource GameCardStyle}"
                    Width="{StaticResource GameCardWidth}"
                    Height="{StaticResource GameCardHeight}"
                    RightTapped="GameCard_RightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                          CornerRadius="4">
                        <Image Source="{x:Bind CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}" Stretch="UniformToFill"
                               Visibility="{x:Bind HasCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xE7FC;" FontSize="48" Opacity="0.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{x:Bind HasNoCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <InfoBadge Style="{ThemeResource CautionIconInfoBadgeStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="4,4,36,4"
                                   Visibility="{x:Bind HasLargeFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                   ToolTipService.ToolTip="Contains files larger than 4GB (FAT32 incompatible)"/>
                        <Button x:Name="OpenFolderButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="4"
                                Padding="4"
                                MinWidth="0"
                                Click="OpenFolderButton_Click"
                                ToolTipService.ToolTip="Open folder in File Explorer">
                            <FontIcon Glyph="&#xE838;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{x:Bind Name}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,2"/>
                    <TextBlock Grid.Row="2" Text="{x:Bind Categories, Converter={StaticResource CategoryFormatConverter}}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind TotalBytes, Converter={StaticResource BytesToSizeConverter}}"
                                   Opacity="0.7" FontSize="12" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind TotalBytes, Converter={StaticResource GameSizeToPriceConverter}}"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Visibility="{x:Bind Category, Converter={StaticResource GameCategoryToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,8"
                        PlaceholderText="Search films &amp; TV..."
                        QueryIcon="Find"
                        FontSize="24" MinHeight="40"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="SearchBox_TextChanged"
                        SuggestionChosen="SearchBox_SuggestionChosen"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        HorizontalAlignment="Stretch">
            <AutoSuggestBox.Resources>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonFontSize">24</x:Double>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonMinWidth">40</x:Double>
                <x:Double x:Key="AutoSuggestBoxDeleteButtonMinHeight">40</x:Double>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </AutoSuggestBox.Resources>
        </AutoSuggestBox>


        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Sort by:" VerticalAlignment="Center" Opacity="0.8" />
            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTvAndFilmsSortOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedTvAndFilmsSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="170" VerticalAlignment="Center"/>
            <Button Command="{x:Bind ViewModel.ToggleTvAndFilmsSortDirectionCommand}"
                    Padding="8" VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind ViewModel.IsTvAndFilmsSortAscending, Mode=OneWay, Converter={StaticResource SortDirectionToolTipConverter}}">
                <FontIcon Glyph="{x:Bind ViewModel.IsTvAndFilmsSortAscending, Mode=OneWay, Converter={StaticResource SortDirectionGlyphConverter}}" FontSize="12"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.EmptyTvAndFilmsMessage, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="400" Opacity="0.7"
                       Visibility="{x:Bind ViewModel.IsTvAndFilmsEmpty, Mode=OneWay}"/>

            <GridView x:Name="TvAndFilmsGridView"
                      ItemsSource="{x:Bind ViewModel.TvAndFilms, Mode=OneWay}"
                      ItemTemplate="{StaticResource LibraryItemTemplate}"
                      SelectionMode="Multiple"
                      SelectionChanged="TvAndFilmsGridView_SelectionChanged"
                      IsItemClickEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
